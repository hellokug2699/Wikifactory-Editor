{
  "applicationId": "top.wikifactory.editor",
  "version": "1.2.3",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "os.open"
  ],
  "modes": {
    "window": {
      "title": "Wikifactory Editor",
      "width": 1440,
      "height": 920,
      "minWidth": 900,
      "minHeight": 600,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/assets/icons/app-icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "WikifactoryEditor",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  },
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  }
}
