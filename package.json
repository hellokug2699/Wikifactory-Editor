{
  "name": "wikifactory-editor",
  "version": "1.3.1",
  "private": true,
  "description": "Wikifactory Content contributor editor with syntax highlighting and client-side GitHub PR flow.",
  "type": "module",
  "scripts": {
    "build": "npm run build:vendor && npm run build:web && npm run build:desktop",
    "build:web": "node scripts/build-web.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:android": "node scripts/build-android.mjs",
    "build:android:release": "node scripts/android-release.mjs",
    "sign:windows": "node scripts/sign-windows.mjs",
    "test": "node scripts/version.mjs --check && node scripts/editor-config.mjs --check && node scripts/config-sign.mjs --verify && node scripts/selftest.mjs && node scripts/github-selftest.mjs && node scripts/token-selftest.mjs && node --test",
    "lint": "eslint . && prettier --check \"app/assets/js/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"eslint.config.js\"",
    "lint:fix": "eslint . --fix && prettier --write \"app/assets/js/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"eslint.config.js\"",
    "format": "prettier --write \"app/assets/js/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"eslint.config.js\"",
    "build:vendor": "node scripts/build-vendor.mjs",
    "rules:hash": "node scripts/rules-sync.mjs --hash",
    "rules:check": "node scripts/rules-sync.mjs --check",
    "rules:sync": "node scripts/rules-sync.mjs --write",
    "tags:check": "node scripts/tags-sync.mjs --check",
    "tags:sync": "node scripts/tags-sync.mjs --write",
    "test:unit": "node --test",
    "test:e2e": "node tests/e2e/main-flow.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs --sync",
    "config:check": "node scripts/editor-config.mjs --check",
    "config:sync": "node scripts/editor-config.mjs --sync",
    "repo:audit": "node scripts/repo-audit.mjs",
    "config:keygen": "node scripts/config-sign.mjs --keygen",
    "config:sign": "node scripts/config-sign.mjs --sign",
    "config:verify": "node scripts/config-sign.mjs --verify"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@neutralinojs/neu": "11.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
