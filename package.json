{
  "name": "wikifactory-editor",
  "version": "1.1.7",
  "private": true,
  "description": "Wikifactory Content contributor editor with syntax highlighting and client-side GitHub PR flow.",
  "type": "module",
  "scripts": {
    "build": "npm run build:vendor && npm run build:web && npm run build:desktop",
    "build:web": "node scripts/build-web.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:android": "node scripts/build-android.mjs",
    "test": "node scripts/selftest.mjs && node scripts/github-selftest.mjs && node scripts/token-selftest.mjs",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@neutralinojs/neu": "11.8.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
